<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- World map pin for a guild death. Behaviour lives in UI\MapPins.lua. -->
  <Frame name="WarcrestDeathPinTemplate" mixin="WarcrestDeathPinMixin" enableMouse="true" virtual="true">
    <Size x="18" y="18"/>
    <Layers>
      <Layer level="OVERLAY">
        <Texture parentKey="Icon" setAllPoints="true"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnEnter method="OnMouseEnter"/>
      <OnLeave method="OnMouseLeave"/>
      <OnMouseUp method="OnMouseUp"/>
    </Scripts>
  </Frame>
</Ui>
